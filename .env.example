# Fourth Down Edge — environment template
# Copy to apps/web/.env.local for local development. Never commit real values.

# Supabase (frontend uses the anon key ONLY — never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When Supabase is not configured the app runs in Local Demo Mode with a
# clearly-labeled local session and demonstration data only.

# Future Python analytical service (FastAPI). Not consumed by v1 frontend.
FDE_API_BASE_URL=
FDE_API_SERVICE_TOKEN=

# NEVER put in any env file, anywhere:
# - sportsbook usernames, passwords, cookies, or session tokens
# - payment card data
# - Supabase service_role key in any frontend-reachable file
