# Fourth Down Edge — environment template
#
# Two separate environments, and mixing them up is the usual first mistake:
#
#   apps/web   the frontend. Copy the VITE_ block to apps/web/.env.local.
#   apps/api   the analytical engine. Copy the FDE_ block to apps/api/.env,
#              which `config.py` reads directly (env_prefix="FDE_").
#
# Both files are gitignored. Never commit real values.

# --------------------------------------------------------------------------
# Frontend — apps/web/.env.local
# --------------------------------------------------------------------------

# Supabase (frontend uses the anon key ONLY — never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When Supabase is not configured the app runs in Local Demo Mode with a
# clearly-labeled local session and demonstration data only.

# Engine base URL for the browser. Leave blank to use the dev proxy at
# /research-api, which is the same-origin path vite.config.ts declares.
#
# Anything VITE_-prefixed is INLINED INTO THE SHIPPED BUNDLE as a string
# literal, so a credential must never be given a VITE_ name. `npm run
# audit:bundle` builds with canary values and greps the output to enforce it.
VITE_FDE_API_URL=

# --------------------------------------------------------------------------
# Vite dev server only — NOT inlined, read server-side by the proxy
# --------------------------------------------------------------------------

# Where the dev proxy forwards /research-api (default http://127.0.0.1:8000).
FDE_RESEARCH_API=
# Bearer token the dev proxy attaches server-side. Deliberately not VITE_.
FDE_API_TOKEN=

# --------------------------------------------------------------------------
# Analytical engine — apps/api/.env
# --------------------------------------------------------------------------

# The odds provider credential. Read from the environment only; never
# logged, never in a URL that reaches an exception message, never in client
# code. Readiness checks fail when it is absent. See docs/security.md.
FDE_ODDS_API_KEY=

# Bearer token for every /v1/* endpoint, compared with compare_digest. An
# unset token FAILS CLOSED: every endpoint returns 503.
FDE_API_TOKEN=

# Set to exactly 1 to serve without authentication on purpose — for local
# development. Ignored when FDE_API_TOKEN is set, so the opt-out cannot
# disable a token that exists.
FDE_ALLOW_UNAUTHENTICATED=

# Database. Defaults to a local SQLite file; CI and any real deployment use
# PostgreSQL. The PostgreSQL-marked tests FAIL rather than fall back when
# this is absent, because a race silently downgraded to SQLite would be
# reported as verified when SQLite had serialised it away.
FDE_DATABASE_URL=

# --------------------------------------------------------------------------
# NEVER put in any env file, anywhere
# --------------------------------------------------------------------------
# - sportsbook usernames, passwords, cookies, or session tokens
# - payment card data
# - Supabase service_role key in any frontend-reachable file
