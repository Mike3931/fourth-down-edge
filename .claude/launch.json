{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@fde/web"
      ],
      "port": 5173
    },
    {
      "name": "engine",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/api",
        "--env-file",
        "apps/api/.env",
        "uvicorn",
        "fde_api.api.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
